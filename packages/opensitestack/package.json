{
  "name": "opensitestack",
  "version": "1.0.1",
  "description": "A typed multisite platform core for Next.js.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITextremeDE/opensitestack.git",
    "directory": "packages/opensitestack"
  },
  "homepage": "https://github.com/ITextremeDE/opensitestack#readme",
  "bugs": "https://github.com/ITextremeDE/opensitestack/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "next": ">=16.0.0 <17",
    "react": ">=19.0.0 <20"
  },
  "devDependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "tsup": "^8.5.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
