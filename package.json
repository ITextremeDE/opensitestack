{
  "name": "opensitestack-workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm --filter opensitestack build && pnpm --filter @opensitestack/example-basic build",
    "build:package": "pnpm --filter opensitestack build",
    "check": "pnpm lint && pnpm test && pnpm validate:docs && pnpm build:package && pnpm --filter @opensitestack/example-basic validate:content && pnpm typecheck && pnpm --filter @opensitestack/example-basic build",
    "dev": "pnpm --filter @opensitestack/example-basic dev",
    "lint": "eslint .",
    "test": "pnpm --filter opensitestack test",
    "validate:docs": "node scripts/validate-docs.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.0",
    "react": "19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
