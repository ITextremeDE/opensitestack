{
  "name": "opensitestack-workspace",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "pnpm --filter opensitestack build && pnpm --filter @opensitestack/example-basic build",
    "build:package": "pnpm --filter opensitestack build",
    "check": "pnpm lint && pnpm test && pnpm test:quality && pnpm validate:docs && pnpm build:package && pnpm --filter @opensitestack/example-basic validate:content && pnpm typecheck && pnpm --filter @opensitestack/example-basic build",
    "dev": "pnpm --filter @opensitestack/example-basic dev",
    "lint": "eslint .",
    "release:check": "pnpm check && pnpm audit --audit-level=low && pnpm --filter opensitestack exec npm pack --dry-run",
    "test": "pnpm --filter opensitestack test",
    "validate:docs": "node scripts/validate-docs.mjs",
    "typecheck": "pnpm -r typecheck",
    "test:quality": "node --test scripts/quality/*.test.mjs && vitest run examples/basic/test/consent-registration.test.ts",
    "test:browser": "playwright test",
    "quality:measure": "lhci collect && node scripts/quality/check-budgets.mjs --measure-only",
    "quality:budgets": "lhci collect && node scripts/quality/check-budgets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "next": "16.4.1",
    "react": "19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
